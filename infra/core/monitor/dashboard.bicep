// Azure Monitor dashboard with Grafana (in the Azure portal: Monitor > Dashboards with Grafana).
// The definition is generated by observability/dashboard.py; this module fills in the environment's
// resources. Viewers need Reader on the dashboard and Monitoring Reader on the data it queries.

@description('Dashboard resource name.')
param name string

param location string = resourceGroup().location

@description('Resource id of the Application Insights component that receives the run events.')
param appInsightsId string

@description('Foundry (AI Services) account name, for the model token and request metrics.')
param foundryAccountName string

@description('Service Bus namespace name, for the intake queue metrics.')
param serviceBusNamespaceName string

@description('Base URL of the analyst UI, for the Run Details links (https://<ui-fqdn>).')
param uiUrl string

param tags object = {}

var template = loadTextContent('../../../observability/dashboards/ach-remittance.json')
var definition = replace(replace(replace(replace(replace(replace(replace(template,
  '__APPI_ID__', appInsightsId),
  '__SUBSCRIPTION_ID__', subscription().subscriptionId),
  '__RESOURCE_GROUP__', resourceGroup().name),
  '__FOUNDRY_NAME__', foundryAccountName),
  '__SERVICEBUS_NAME__', serviceBusNamespaceName),
  '__REGION__', location),
  '__UI_URL__', uiUrl)

resource dashboard 'Microsoft.Dashboard/dashboards@2026-09-01' = {
  name: name
  location: location
  tags: union(tags, { GrafanaDashboardTags: 'ach-remittance' })
  properties: {}
}

resource dashboardDefinition 'Microsoft.Dashboard/dashboards/dashboardDefinitions@2026-09-01' = {
  parent: dashboard
  name: 'default'
  properties: {
    serializedData: definition
  }
}

output dashboardId string = dashboard.id
output dashboardName string = dashboard.name
