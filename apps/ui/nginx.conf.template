server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxy API calls to the FastAPI container app (API_URL is injected at startup).
    location /api/ {
        # nginx default is 1 MB; .msg uploads can be larger (API allows up to MAX_MSG_SIZE_MB=25).
        client_max_body_size 30m;
        proxy_pass ${API_URL};
        # nginx proxies to upstreams as HTTP/1.0 by default; Azure Container Apps' Envoy
        # ingress rejects HTTP/1.0 with "426 Upgrade Required". Force HTTP/1.1 (and clear
        # the hop-by-hop Connection header so keepalive works) on the nginx->API hop.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # The API uses Azure Container Apps internal ingress (HTTPS-only), whose Envoy
        # front end routes by SNI + Host. Send SNI and let Host/SNI default to the API
        # FQDN from proxy_pass; overriding Host with $host breaks Envoy routing and
        # omitting SNI makes Envoy reset the TLS handshake (502).
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

    # Single-page app fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
